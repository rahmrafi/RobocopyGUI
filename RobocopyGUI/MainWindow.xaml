<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RobocopyGUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RobocopyGUI"
    Title="RobocopyGUI">

    <Window.Resources>
        <local:BoolNegationConverter x:Key="NegateBool" />
    </Window.Resources>

    <Grid Padding="20" RowSpacing="14" ColumnSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Source folder -->
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Header="Source folder"
                     Text="{x:Bind ViewModel.SourcePath, Mode=TwoWay}"
                     PlaceholderText="C:\path\to\source" />
            <Button Grid.Column="1" Content="Browse..." VerticalAlignment="Bottom"
                    Click="BrowseSource_Click" />
        </Grid>

        <!-- Destination folder -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Header="Destination folder"
                     Text="{x:Bind ViewModel.DestinationPath, Mode=TwoWay}"
                     PlaceholderText="C:\path\to\destination" />
            <Button Grid.Column="1" Content="Browse..." VerticalAlignment="Bottom"
                    Click="BrowseDestination_Click" />
        </Grid>

        <!-- File filter -->
        <TextBox Grid.Row="2" Header="File filter"
                 Text="{x:Bind ViewModel.FileFilter, Mode=TwoWay}"
                 PlaceholderText="*.* or *.docx *.xlsx" />

        <!-- Copy behavior options -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="20">
            <CheckBox Content="Mirror (/MIR)" IsChecked="{x:Bind ViewModel.Mirror, Mode=TwoWay}" />
            <CheckBox Content="Copy subdirectories (/E)" IsChecked="{x:Bind ViewModel.CopySubdirectories, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.Mirror, Mode=OneWay, Converter={StaticResource NegateBool}}" />
            <CheckBox Content="Purge extras (/PURGE)" IsChecked="{x:Bind ViewModel.Purge, Mode=TwoWay}"
                      IsEnabled="{x:Bind ViewModel.Mirror, Mode=OneWay, Converter={StaticResource NegateBool}}" />
            <CheckBox Content="Restartable mode (/Z)" IsChecked="{x:Bind ViewModel.RestartableMode, Mode=TwoWay}" />
        </StackPanel>

        <!-- Performance / retry options -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="20">
            <CheckBox Content="Multithreaded" IsChecked="{x:Bind ViewModel.MultiThreaded, Mode=TwoWay}" />
            <NumberBox Header="Threads" Value="{x:Bind ViewModel.ThreadCount, Mode=TwoWay}"
                       SpinButtonPlacementMode="Compact" Minimum="1" Maximum="128" Width="110"
                       IsEnabled="{x:Bind ViewModel.MultiThreaded, Mode=OneWay}" />
            <NumberBox Header="Retries" Value="{x:Bind ViewModel.RetryCount, Mode=TwoWay}"
                       SpinButtonPlacementMode="Compact" Minimum="0" Maximum="1000000" Width="110" />
            <NumberBox Header="Wait (sec)" Value="{x:Bind ViewModel.WaitSeconds, Mode=TwoWay}"
                       SpinButtonPlacementMode="Compact" Minimum="0" Maximum="3600" Width="110" />
        </StackPanel>

        <!-- Live log -->
        <Border Grid.Row="5" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4">
            <ListView x:Name="LogListView" ItemsSource="{x:Bind ViewModel.LogLines}" Padding="4">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12" TextWrapping="NoWrap" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Status + actions -->
        <Grid Grid.Row="6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
                           FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>

            <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                          Width="24" Height="24" VerticalAlignment="Center" />

            <Button Grid.Column="2" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}"
                    VerticalAlignment="Center" />

            <Button Grid.Column="3" Content="Start" Command="{x:Bind ViewModel.StartCommand}"
                    Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
        </Grid>
    </Grid>

</Window>